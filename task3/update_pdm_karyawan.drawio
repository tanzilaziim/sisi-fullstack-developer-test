        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    MENU_LEVEL {\n        varchar_3 ID_LEVEL PK\n        varchar_60 LEVEL\n    }\n\n    USER {\n        varchar_30 ID_USER PK\n        varchar_60 NAMA_USER\n        varchar_60 USERNAME\n        varchar_60 PASSWORD\n        varchar_200 EMAIL\n        varchar_30 NO_HP\n        varchar_30 WA\n        varchar_30 PIN\n        varchar_3 ID_JENIS_USER\n        varchar_30 STATUS_USER\n        varchar_1 DELETE_MARK\n        varchar_30 CREATE_BY\n        timestamp CREATE_DATE\n        varchar_30 UPDATE_BY\n        timestamp UPDATE_DATE\n    }\n\n    MENU {\n        varchar_3 MENU_ID PK\n        varchar_3 ID_LEVEL FK\n        varchar_300 MENU_NAME\n        varchar_300 MENU_LINK\n        varchar_300 MENU_ICON\n        varchar_30 PARENT_ID\n        varchar_30 CREATE_BY\n        date CREATE_DATE\n        varchar_1 DELETE_MARK\n        varchar_30 UPDATE_BY\n        date UPDATE_DATE\n    }\n\n    MENU_USER {\n        int NO_SETTING PK\n        varchar_30 ID_USER FK\n        varchar_3 MENU_ID FK\n        varchar_30 CREATE_DATE\n        timestamp CREATE_TIME\n        varchar_1 DELETE_MARK\n        varchar_30 UPDATE_BY\n        timestamp UPDATE_DATE\n    }\n\n    USER_FOTO {\n        int NO_FOTO PK\n        varchar_30 ID_USER FK\n        varchar_200 FOTO\n        varchar_30 CREATE_BY\n        timestamp CREATE_DATE\n        varchar_1 DELETE_MARK\n        varchar_30 UPDATE_BY\n        timestamp UPDATE_DATE\n    }\n\n    USER_ACTIVITY {\n        int NO_ACTIVITY PK\n        varchar_30 ID_USER FK\n        varchar_300 DISCRIPSI\n        varchar_30 STATUS\n        varchar_3 MENU_ID\n        varchar_1 DELETE_MARK\n        varchar_30 CREATE_BY\n        timestamp CREATE_DATE\n    }\n\n    I_ERROR_APPLICATION {\n        int ERROR_ID PK\n        varchar_30 ID_USER FK\n        varchar_3 ERROR_DATE\n        varchar_100 MODULES\n        varchar_200 CONTROLLER\n        varchar_200 FUNCTION\n        varchar_30 ERROR_LINE\n        varchar_1000 ERROR_MESSAGE\n        varchar_30 STATUS\n        varchar_300 PARAM\n        varchar_30 CREATE_DATE\n        timestamp CREATE_TIME\n        varchar_1 DELETE_MARK\n        varchar_30 UPDATE_BY\n        timestamp UPDATE_DATE\n    }\n\n    POSITION {\n        int POSITION_ID PK\n        varchar_100 POSITION_NAME\n        varchar_300 DESCRIPTION\n    }\n\n    EMPLOYEE {\n        int EMPLOYEE_ID PK\n        varchar_30 ID_USER FK\n        int POSITION_ID FK\n        varchar_30 EMPLOYEE_NUMBER\n        varchar_30 NATIONAL_ID\n        varchar_100 EMPLOYEE_NAME\n        varchar_200 EMAIL\n        varchar_30 PHONE\n        varchar_300 ADDRESS\n        date JOIN_DATE\n        decimal_15_2 BASIC_SALARY\n        varchar_30 EMPLOYEE_STATUS\n    }\n\n    ATTENDANCE {\n        int ATTENDANCE_ID PK\n        int EMPLOYEE_ID FK\n        date ATTENDANCE_DATE\n        time CHECK_IN\n        time CHECK_OUT\n        varchar_30 ATTENDANCE_STATUS\n        varchar_300 DESCRIPTION\n    }\n\n    LEAVE_REQUEST {\n        int LEAVE_ID PK\n        int EMPLOYEE_ID FK\n        varchar_30 LEAVE_TYPE\n        date START_DATE\n        date END_DATE\n        varchar_300 REASON\n        varchar_30 STATUS\n        varchar_30 APPROVED_BY FK\n    }\n\n    BUSINESS_TRIP {\n        int BUSINESS_TRIP_ID PK\n        int EMPLOYEE_ID FK\n        varchar_50 SPPD_NUMBER\n        date DEPARTURE_DATE\n        date RETURN_DATE\n        varchar_200 DESTINATION\n        varchar_300 PURPOSE\n        varchar_100 TRANSPORTATION\n        decimal_15_2 COST\n        varchar_30 STATUS\n    }\n\n    DEDUCTION_TYPE {\n        int DEDUCTION_TYPE_ID PK\n        varchar_100 DEDUCTION_NAME\n        varchar_300 DESCRIPTION\n    }\n\n    PAYROLL {\n        int PAYROLL_ID PK\n        int EMPLOYEE_ID FK\n        int MONTH\n        int YEAR\n        decimal_15_2 BASIC_SALARY\n        decimal_15_2 TOTAL_DEDUCTION\n        decimal_15_2 NET_SALARY\n        date PROCESS_DATE\n        varchar_30 STATUS\n    }\n\n    PAYROLL_DEDUCTION {\n        int PAYROLL_DEDUCTION_ID PK\n        int PAYROLL_ID FK\n        int DEDUCTION_TYPE_ID FK\n        decimal_15_2 AMOUNT\n    }\n\n    MENU_LEVEL ||--o{ MENU : \&quot;\&quot;\n    USER ||--o{ MENU_USER : \&quot;\&quot;\n    MENU ||--o{ MENU_USER : \&quot;\&quot;\n\n    USER ||--o{ USER_FOTO : \&quot;\&quot;\n    USER ||--o{ USER_ACTIVITY : \&quot;\&quot;\n    USER ||--o{ I_ERROR_APPLICATION : \&quot;\&quot;\n\n    USER o|--o| EMPLOYEE : \&quot;\&quot;\n    POSITION ||--o{ EMPLOYEE : \&quot;\&quot;\n\n    EMPLOYEE ||--o{ ATTENDANCE : \&quot;\&quot;\n    EMPLOYEE ||--o{ LEAVE_REQUEST : \&quot;\&quot;\n    USER o|--o{ LEAVE_REQUEST : \&quot;\&quot;\n    EMPLOYEE ||--o{ BUSINESS_TRIP : \&quot;\&quot;\n    EMPLOYEE ||--o{ PAYROLL : \&quot;\&quot;\n\n    PAYROLL ||--o{ PAYROLL_DEDUCTION : \&quot;\&quot;\n    DEDUCTION_TYPE ||--o{ PAYROLL_DEDUCTION : \&quot;\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="o7R7_qy6xp-NqxsiKsN9-524">
